{
  "manifest_version": 3,
  "name": "Content Filter",
  "version": "1.0.0",
  "description": "Filter content by keyword",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.reddit.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.reddit.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}